{
  "name": "bookeeping-agent",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^24",
      "@flue/cli": "1.0.0-beta.7",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "ultracite check",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:agent": "vp run --filter agent dev",
    "agent:build": "vp run --filter agent build",
    "agent:start": "vp run --filter agent start",
    "db:push": "vp run --filter @bookeeping-agent/db db:push",
    "db:studio": "vp run --filter @bookeeping-agent/db db:studio",
    "db:generate": "vp run --filter @bookeeping-agent/db db:generate",
    "db:migrate": "vp run --filter @bookeeping-agent/db db:migrate",
    "db:seed": "vp run --filter @bookeeping-agent/db db:seed",
    "db:start": "vp run --filter @bookeeping-agent/db db:start",
    "db:watch": "vp run --filter @bookeeping-agent/db db:watch",
    "db:stop": "vp run --filter @bookeeping-agent/db db:stop",
    "db:down": "vp run --filter @bookeeping-agent/db db:down",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@bookeeping-agent/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@bookeeping-agent/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "rolldown": "1.1.1",
    "typescript": "catalog:",
    "ultracite": "7.8.3",
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.3.14"
}
