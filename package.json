{
  "name": "bookeeping-agent",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.0-beta.97",
      "@effect/opentelemetry": "4.0.0-beta.97",
      "@effect/vitest": "4.0.0-beta.97",
      "@opentelemetry/api": "1.9.0",
      "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
      "@opentelemetry/resources": "2.10.0",
      "@opentelemetry/sdk-node": "0.221.0",
      "@opentelemetry/sdk-trace-base": "2.10.0",
      "@opentelemetry/semantic-conventions": "1.43.0",
      "vitest": "^4.1.9",
      "typescript": "^6",
      "@types/node": "^24",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "overrides": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "scripts": {
    "prepare-effect": "./scripts/prepare-effect.sh",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "ultracite check",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:agent": "vp run --filter agent dev",
    "motel": "bunx @kitlangton/motel",
    "agent:build": "vp run --filter agent build",
    "agent:start": "vp run --filter agent start",
    "db:push": "vp run --filter @bookeeping-agent/db db:push",
    "db:studio": "vp run --filter @bookeeping-agent/db db:studio",
    "db:generate": "vp run --filter @bookeeping-agent/db db:generate",
    "db:migrate": "vp run --filter @bookeeping-agent/db db:migrate",
    "db:seed": "vp run --filter @bookeeping-agent/db db:seed",
    "db:start": "vp run --filter @bookeeping-agent/db db:start",
    "db:watch": "vp run --filter @bookeeping-agent/db db:watch",
    "db:stop": "vp run --filter @bookeeping-agent/db db:stop",
    "db:down": "vp run --filter @bookeeping-agent/db db:down",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@bookeeping-agent/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "rolldown": "1.1.4",
    "typescript": "catalog:",
    "ultracite": "7.9.2",
    "vite-plus": "0.2.3"
  },
  "packageManager": "bun@1.3.14"
}
